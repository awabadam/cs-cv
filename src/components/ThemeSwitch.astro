---
import { localeOf, ui } from "@/i18n/ui";

/* One button that flips between light and dark. The site follows the system until it is
   pressed; a choice that matches the system goes back to following it, anything else is kept
   in localStorage and applied before first paint by the script in Base.astro, as
   html[data-theme]. The icon is chosen from that attribute (global.css), so it is right at once:
   a moon on a light page, a sun on a dark one. */
const tx = ui[localeOf(Astro.url)];
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label={tx.themes.dark}
  title={tx.theme}
  class="theme-toggle grid size-6 place-items-center rounded-full text-muted hover:text-fg"
>
  <svg
    width="14"
    height="14"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path class="i-moon" d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1z" />
    <g class="i-sun">
      <circle cx="8" cy="8" r="2.75" />
      <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" />
    </g>
  </svg>
</button>

<script>
  import { eachPage } from "@/scripts/page";

  const root = document.documentElement;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  const isDark = () => (root.dataset.theme ?? (system.matches ? "dark" : "light")) === "dark";
  const sync = () => document.querySelector("[data-theme-toggle]")?.setAttribute("aria-pressed", String(isDark()));

  /* Every colour changes in the same instant, rather than each link fading on its own. */
  const flip = () => {
    const dark = !isDark();
    if (dark === system.matches) delete root.dataset.theme;
    else root.dataset.theme = dark ? "dark" : "light";
    try {
      if (root.dataset.theme) localStorage.setItem("theme", root.dataset.theme);
      else localStorage.removeItem("theme");
    } catch {}
    root.classList.add("instant");
    sync();
    void root.offsetWidth;
    root.classList.remove("instant");
  };

  /* Where the browser can, the whole page cross-fades to the new colours. */
  eachPage(() => {
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
      if ("startViewTransition" in document && !calm.matches) document.startViewTransition(flip);
      else flip();
    });
    sync();
  });
  system.addEventListener("change", sync);
</script>
