---
import { localeOf, ui } from "@/i18n/ui";

/* A round button in the far corner that glides back to the top (the section-link handler in
   Base.astro). It comes up once the page is more than a screen down, and steps aside when the
   footer, with its own link to the top, is in view. */
const tx = ui[localeOf(Astro.url)];
---

<a href="#top" class="to-top" aria-label={tx.toTop} title={tx.toTop} data-to-top>
  <svg
    width="14"
    height="14"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M8 13.5v-11M3.5 7 8 2.5 12.5 7" />
  </svg>
</a>

<script>
  import { eachPage } from "@/scripts/page";

  eachPage((signal) => {
    const button = document.querySelector<HTMLElement>("[data-to-top]");
    if (!button) return;
    const footer = document.querySelector("[data-site-footer]");
    let down = false;
    let foot = false;
    const update = () => button.toggleAttribute("data-shown", down && !foot);
    addEventListener(
      "scroll",
      () => {
        const now = scrollY > innerHeight * 1.2;
        if (now === down) return;
        down = now;
        update();
      },
      { passive: true, signal }
    );
    if (footer) {
      const io = new IntersectionObserver(([e]) => {
        foot = e.isIntersecting;
        update();
      });
      io.observe(footer);
      signal.addEventListener("abort", () => io.disconnect());
    }
    down = scrollY > innerHeight * 1.2;
    update();
  });
</script>
