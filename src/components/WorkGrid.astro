---
import ProjectCard from "@/components/ProjectCard.astro";
import { kindLabels, kinds, projects } from "@/data/work";

/* Every project, with chips that filter by discipline. The filter only hides cards. */
const chipClass =
  "shrink-0 whitespace-nowrap px-3 py-1.5 rounded-full text-sm border border-line transition-colors aria-pressed:bg-fg aria-pressed:text-bg aria-pressed:border-fg hover:border-fg";
---

<div data-workgrid>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-line pt-4 mb-6">
    <h2 class="text-lg font-medium">
      Work <span class="text-muted font-normal" data-count>{projects.length}</span>
    </h2>
    <div
      class="chips flex gap-2 overflow-x-auto w-[calc(100%+32px)] -mx-4 px-4 sm:w-auto sm:mx-0 sm:px-0 sm:flex-wrap sm:overflow-visible"
      role="group"
      aria-label="Filter by discipline"
    >
      <button type="button" data-kind="" aria-pressed="true" class={chipClass}>All</button>
      {
        kinds.map((k) => (
          <button type="button" data-kind={k} aria-pressed="false" class={chipClass}>
            {kindLabels[k]}
          </button>
        ))
      }
    </div>
  </div>

  <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((p, i) => (
        <li data-kinds={p.kind.join(" ")}>
          <ProjectCard
            project={p}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            eager={i < 6}
          />
        </li>
      ))
    }
  </ul>
</div>

<script>
  const grid = document.querySelector<HTMLElement>("[data-workgrid]");
  if (grid) {
    const chips = grid.querySelectorAll<HTMLButtonElement>("[data-kind]");
    const cards = grid.querySelectorAll<HTMLElement>("[data-kinds]");
    const count = grid.querySelector("[data-count]")!;
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        const k = chip.dataset.kind;
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        let shown = 0;
        cards.forEach((card) => {
          card.hidden = !!k && !card.dataset.kinds!.split(" ").includes(k);
          if (!card.hidden) shown++;
        });
        count.textContent = String(shown);
      })
    );
  }
</script>
