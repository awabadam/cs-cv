---
import type { Project } from "@/data/work";
import { localeOf, ui } from "@/i18n/ui";

/* The project's copy, beside its scope, facts and palette. */
interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const tx = ui[localeOf(Astro.url)];
const sampled = p.palette.filter((c) => c.source === "sampled");
const paletteNote = !sampled.length
  ? null
  : sampled.length === p.palette.length
    ? tx.sampledAll
    : tx.sampledSome(sampled.map((c) => c.name || c.hex.toUpperCase()).join(tx.listSep));
---

<div class="grid gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,1fr)_340px] mt-10">
  <div class="prose max-w-[68ch] space-y-4 text-[17px] leading-relaxed">
    {
      p.copy.map((c) => (
        <p>
          {c.lead && <strong class="font-medium">{c.lead} </strong>}
          <span set:html={c.text} />
        </p>
      ))
    }
  </div>

  <aside class="text-sm space-y-6">
    <dl class="grid grid-cols-[112px_minmax(0,1fr)] gap-x-4 gap-y-2">
      {
        p.disciplines.length > 0 && (
          <>
            <dt class="text-muted">{tx.scope}</dt>
            <dd>{p.disciplines.join(tx.listSep)}</dd>
          </>
        )
      }
      {
        p.facts.map((f) => (
          <div class="contents">
            <dt class="text-muted">{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>

    {
      p.palette.length > 0 && (
        <div>
          <p class="text-muted mb-2">{tx.palette}</p>
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            {p.palette.map((c) => (
              <li class="flex items-center gap-2">
                <span
                  class="size-5 rounded-full border border-line"
                  style={`background: ${c.hex}`}
                  aria-hidden="true"
                />
                <span class="font-mono text-xs">
                  <span dir="ltr">{c.hex.toUpperCase()}</span>
                  {c.name && <span class="text-muted"> {c.name}</span>}
                </span>
              </li>
            ))}
          </ul>
          {paletteNote && <p class="mt-2 text-xs text-muted">{paletteNote}</p>}
        </div>
      )
    }
  </aside>
</div>
