---
import Clip from "@/components/Clip.astro";
import Pic from "@/components/Pic.astro";
import { images, plain, type Img } from "@/data/work";
import { localeOf, ui } from "@/i18n/ui";

/* One image (or clip) in a project gallery, as a button that opens the viewer. Every one but the
   cover (priority, already in view) opens up as it scrolls in (global.css). */
interface Props {
  item: Img;
  sizes: string;
  priority?: boolean;
}

const { item, sizes, priority = false } = Astro.props;
const m = images[item.img];
const alt = plain(item.cap);
const tx = ui[localeOf(Astro.url)];
---

<figure>
  <button
    type="button"
    class:list={["zoom", { reveal: !priority }]}
    data-alt={alt}
    aria-label={item.cap ? tx.enlarge(alt) : tx.enlargeImage}
  >
    {
      m.video ? (
        <Clip src={m.video} poster={m.src} w={m.w} h={m.h} />
      ) : (
        <Pic src={m.src} alt="" sizes={sizes} priority={priority} />
      )
    }
  </button>
  {item.cap && <figcaption class="cap" set:html={item.cap} />}
</figure>
