---
import { localeOf, ui } from "@/i18n/ui";

/* The foot of every page: the time in Istanbul, large, beside a few cities a client might be
   writing from, then the small print. The clocks are set in the visitor's browser (the build
   only knows its own moment) and keep the minute after that. */
const tx = ui[localeOf(Astro.url)];

const HOME = "Europe/Istanbul";
const CITIES = [
  ["Europe/London", tx.cities.london],
  ["America/New_York", tx.cities.newYork],
  ["Asia/Dubai", tx.cities.dubai],
  ["Asia/Tokyo", tx.cities.tokyo],
] as const;

/* "GMT+3", as the zone stands on the day of the build; the script keeps it current. */
const offset = (zone: string) =>
  new Intl.DateTimeFormat("en-GB", { timeZone: zone, timeZoneName: "shortOffset" })
    .formatToParts()
    .find((p) => p.type === "timeZoneName")!.value;
---

<footer class="wrap mt-[clamp(64px,8vw,128px)] pb-6" data-site-footer>
  <div class="grid gap-x-6 gap-y-10 border-t border-line pt-6 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="label flex gap-3">
        <span>{tx.localTime}</span>
        <span class="text-muted">{tx.city}</span>
      </p>
      <p class="mt-4 flex items-baseline gap-4" dir="ltr">
        <time class="clock font-mono text-[clamp(3.5rem,9vw,8rem)] leading-[0.9] tracking-[-0.05em]" data-clock={HOME} data-blink>
          --:--
        </time>
        <span class="label font-mono text-muted" data-offset={HOME}>{offset(HOME)}</span>
      </p>
    </div>
    <ul class="grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-4 md:col-span-7 md:self-end">
      {
        CITIES.map(([zone, name]) => (
          <li class="border-t border-line pt-3">
            <p class="label text-muted">{name}</p>
            <p class="mt-2 flex items-baseline justify-between gap-2" dir="ltr">
              <time class="clock font-mono text-[clamp(1.5rem,2.2vw,2rem)] leading-none tracking-[-0.03em]" data-clock={zone}>
                --:--
              </time>
              <span class="font-mono text-xs text-muted" data-offset={zone} data-from={HOME} />
            </p>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="label mt-16 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 text-muted sm:mt-24">
    <p>&copy; {new Date().getFullYear()} {tx.name} &middot; {tx.city}</p>
    <a href="mailto:awabe.adam@gmail.com" class="hover:text-fg">awabe.adam@gmail.com</a>
    <a href="#top" class="hover:text-fg">{tx.toTop} <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<script>
  import { eachPage } from "@/scripts/page";

  const parts = (zone: string, now: Date) => {
    const get = (o: Intl.DateTimeFormatOptions) =>
      Object.fromEntries(
        new Intl.DateTimeFormat("en-GB", { timeZone: zone, ...o }).formatToParts(now).map((p) => [p.type, p.value])
      );
    const { hour, minute } = get({ hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
    const name = get({ timeZoneName: "shortOffset" }).timeZoneName;
    /* "GMT", "GMT+3", "GMT-4", "GMT+5:30" → minutes east of Greenwich. */
    const [, sign, h = "0", m = "0"] = name.match(/([+-])?(\d+)?(?::(\d+))?$/) ?? [];
    const east = (sign === "-" ? -1 : 1) * (Number(h) * 60 + Number(m));
    return { hour, minute, name, east };
  };

  /* Hours ahead of or behind Istanbul: "+6H", "−3H", "±0H". */
  const diff = (minutes: number) => {
    const h = Math.abs(minutes) / 60;
    const n = Number.isInteger(h) ? String(h) : h.toFixed(1);
    return `${minutes > 0 ? "+" : minutes < 0 ? "−" : "±"}${n}H`;
  };

  eachPage((signal) => {
    const clocks = document.querySelectorAll<HTMLTimeElement>("[data-clock]");
    if (!clocks.length) return;
    let timer = 0;
    const tick = () => {
      const now = new Date();
      for (const el of clocks) {
        const { hour, minute } = parts(el.dataset.clock!, now);
        el.dateTime = `${hour}:${minute}`;
        el.innerHTML = `${hour}<span class="colon">:</span>${minute}`;
      }
      for (const el of document.querySelectorAll<HTMLElement>("[data-offset]")) {
        const here = parts(el.dataset.offset!, now);
        el.textContent = el.dataset.from ? diff(here.east - parts(el.dataset.from, now).east) : here.name;
      }
      /* Again just after the next minute turns. */
      timer = window.setTimeout(tick, 60_000 - (now.getTime() % 60_000) + 50);
    };
    tick();
    signal.addEventListener("abort", () => clearTimeout(timer));
  });
</script>
