---
import CaseStudyDiagram from "@/components/CaseStudyDiagrams";
import Pic from "@/components/Pic.astro";
import type { Study } from "@/data/studies";
import { localeOf, ui } from "@/i18n/ui";

/* The long-form write-up, for projects that have one. */
interface Props {
  slug: string;
  study: Study;
  first: boolean;
}

const { slug, study: s, first } = Astro.props;
const tx = ui[localeOf(Astro.url)];
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<section class:list={["wrap", first ? "mt-4" : "section"]} aria-labelledby="writeup">
  <p class="head">{tx.caseStudy}</p>
  <div class="grid gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="max-w-[68ch]">
      <h2 id="writeup" class="text-[clamp(1.75rem,3vw,2.625rem)] leading-[1.1] tracking-[-0.02em]">
        {s.title}
      </h2>
      <p class="mt-5 text-[19px] leading-relaxed">{s.lede}</p>

      {
        s.stats && (
          <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 border-y border-line py-5">
            {s.stats.map((st) => (
              <div>
                <p class="text-3xl tracking-[-0.02em]">{st.value}</p>
                <p class="mt-1 text-xs text-muted leading-snug">{st.label}</p>
              </div>
            ))}
          </div>
        )
      }

      {
        s.sections.map((sec, i) => (
          <div class="mt-10">
            <h3 class="text-lg font-medium">{sec.heading}</h3>
            <p class="mt-2 text-[17px] leading-relaxed">{sec.body}</p>
            {sec.plate && (
              <figure class="mt-6">
                <Pic
                  src={sec.plate.src}
                  alt={sec.plate.alt}
                  sizes="(max-width: 768px) 100vw, 760px"
                  class="w-full h-auto bg-panel rounded-img"
                />
                <figcaption class="cap">{sec.plate.caption}</figcaption>
              </figure>
            )}
            {s.diagram?.after === i && (
              <figure class="mt-6">
                <div class="diagram rounded-img border border-line p-4 sm:p-6">
                  <CaseStudyDiagram slug={slug} />
                </div>
                <figcaption class="cap">{s.diagram.caption}</figcaption>
              </figure>
            )}
          </div>
        ))
      }
    </div>

    <aside class="text-sm lg:sticky lg:top-6 lg:self-start">
      <dl class="grid grid-cols-[112px_minmax(0,1fr)] gap-x-4 gap-y-2">
        <dt class="text-muted">{tx.roleLabel}</dt>
        <dd class="font-medium">{s.role}</dd>
        {
          s.facts.map((f) => (
            <div class="contents">
              <dt class="text-muted">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
        {
          s.url && (
            <>
              <dt class="text-muted">{tx.liveSite}</dt>
              <dd>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-3">
                  {host(s.url)} ↗
                </a>
              </dd>
            </>
          )
        }
      </dl>
    </aside>
  </div>
</section>
