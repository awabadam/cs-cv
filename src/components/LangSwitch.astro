---
import { languages, localeOf, localized, locales, ui, unlocalized } from "@/i18n/ui";

/* The page's language, opening onto links to this same page in each language. */
const l = localeOf(Astro.url);
const path = unlocalized(Astro.url);
---

<nav aria-label={ui[l].language}>
  <details class="lang relative" data-lang>
    <summary class="flex cursor-pointer list-none items-center gap-1 text-muted hover:text-fg">
      <span lang={l}>{languages[l].short}</span>
      <svg
        width="8"
        height="8"
        viewBox="0 0 8 8"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M1.5 3 4 5.5 6.5 3" />
      </svg>
    </summary>
    <ul
      class="absolute end-0 top-full z-10 mt-3 min-w-36 rounded-xl border border-line bg-bg p-1 text-[13px] normal-case tracking-normal shadow-[0_8px_24px_-12px_rgb(0_0_0/0.25)]"
    >
      {
        locales.map((to) => (
          <li>
            <a
              href={localized(path, to)}
              hreflang={to}
              lang={to}
              aria-current={to === l ? "page" : undefined}
              class="flex items-center justify-between gap-4 rounded-lg px-3 py-1.5 text-muted hover:bg-panel hover:text-fg aria-[current]:text-fg"
            >
              {languages[to].name}
              {to === l && <span aria-hidden="true">✓</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>

<script>
  import { eachPage } from "@/scripts/page";

  /* The menu closes on a click anywhere else, or on Escape. */
  eachPage((signal) => {
    const menu = document.querySelector<HTMLDetailsElement>("[data-lang]");
    if (!menu) return;
    document.addEventListener(
      "click",
      (e) => {
        if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
      },
      { signal }
    );
    menu.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")!.focus();
    });
  });
</script>
