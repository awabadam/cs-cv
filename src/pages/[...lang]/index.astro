---
import type { GetStaticPaths } from "astro";
import LangSwitch from "@/components/LangSwitch.astro";
import Pic from "@/components/Pic.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import WorkGrid from "@/components/WorkGrid.astro";
import { experience as en, expertise as enSkills, socialLinks } from "@/data/content";
import { localize } from "@/i18n/data";
import { localized, locales, ui, type Locale } from "@/i18n/ui";
import Base from "@/layouts/Base.astro";

/* English at /, the others at /ar and /tr. */
export const getStaticPaths = (() =>
  locales.map((l) => ({ params: { lang: l === "en" ? undefined : l }, props: { l } }))) satisfies GetStaticPaths;

const l: Locale = Astro.props.l;
const tx = ui[l];
const experience = localize(en, l);
const expertise = localize(enSkills, l);

const EMAIL = "awabe.adam@gmail.com";
const PHONE = "+90 554 175 9945";

const nav = [
  [tx.nav.work, "#work"],
  [tx.nav.about, "#about"],
  [tx.nav.experience, "#experience"],
  [tx.nav.contact, "#contact"],
] as const;

const skills = [
  [tx.design, expertise.design],
  [tx.technical, expertise.technical],
] as const;

const head = "border-t border-line pt-4 mb-8 text-lg font-medium scroll-mt-6";
---

<Base description={tx.description} share={{ title: `${tx.name} — ${tx.role}`, description: tx.share }}>
  {/* On a phone the switches sit beside the name and the section links take the next line. */}
  <header class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-5 text-sm">
    <a href={localized("/", l)} class="font-medium">{tx.name}</a>
    <div class="flex items-center gap-4 sm:order-last">
      <LangSwitch />
      <ThemeSwitch />
    </div>
    <nav aria-label={tx.sections} class="flex w-full gap-5 text-muted sm:ms-auto sm:w-auto">
      {
        nav.map(([label, href]) => (
          <a href={href} class="hover:text-fg">
            {label}
          </a>
        ))
      }
    </nav>
  </header>

  <main>
    <section
      class="wrap pt-4 pb-10 sm:pt-6 sm:pb-14 grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-end"
    >
      <h1 class="text-[clamp(2.1rem,4.6vw,4.25rem)] font-semibold leading-[1.02] tracking-[-0.02em]">
        {tx.hero.title}{" "}
        <span class="text-muted">{tx.hero.muted}</span>
      </h1>
      <div class="max-w-[60ch] text-[15px] sm:text-[17px] leading-relaxed">
        <p>{tx.hero.intro}</p>
        <p class="mt-4 text-sm">
          <a href={`mailto:${EMAIL}`} class="underline underline-offset-3">{EMAIL}</a>
          <span class="text-muted"> &middot; </span>
          <a
            href="https://www.linkedin.com/in/awab-adam"
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-3"
          >
            LinkedIn
          </a>
        </p>
      </div>
    </section>

    <section id="work" class="wrap scroll-mt-6" aria-label={tx.nav.work}>
      <WorkGrid />
    </section>

    <section class="wrap mt-28" aria-labelledby="about">
      <h2 id="about" class={head}>{tx.nav.about}</h2>
      <div class="grid gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <Pic
          src="/images/story/profile-photo-of-awab.jpg"
          alt={tx.name}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="w-full h-auto bg-panel rounded-img"
        />
        <div class="max-w-[60ch] space-y-4 text-[17px] leading-relaxed">
          {tx.about.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </section>

    <section class="wrap mt-28" aria-labelledby="experience">
      <h2 id="experience" class={head}>{tx.nav.experience}</h2>
      <ol>
        {
          experience.map((e) => (
            <li class="grid gap-x-8 gap-y-1 border-b border-line py-5 first:pt-0 md:grid-cols-[150px_minmax(0,1fr)_minmax(0,1.3fr)]">
              <p class="font-mono text-xs text-muted pt-1">{e.period}</p>
              <div>
                <p class="font-medium">{e.role}</p>
                <p class="text-sm text-muted">
                  {e.company} &middot; {e.location}
                </p>
              </div>
              <p class="text-[15px] leading-relaxed max-w-[70ch]">{e.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap mt-28" aria-labelledby="skills">
      <h2 id="skills" class={head}>{tx.nav.skills}</h2>
      <div class="grid gap-8 sm:grid-cols-2">
        {
          skills.map(([label, list]) => (
            <div>
              <p class="text-sm text-muted mb-3">{label}</p>
              <ul class="space-y-1.5 text-[15px]">
                {list.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap mt-28" aria-labelledby="contact">
      <h2 id="contact" class={head}>{tx.nav.contact}</h2>
      <a
        href={`mailto:${EMAIL}`}
        class="block w-fit text-[clamp(1.6rem,4vw,3.25rem)] font-semibold tracking-[-0.02em] leading-tight underline decoration-line underline-offset-[0.15em] hover:decoration-fg break-all sm:break-normal"
      >
        {EMAIL}
      </a>
      <dl class="mt-8 grid grid-cols-[112px_minmax(0,1fr)] gap-x-4 gap-y-2 text-[15px] max-w-xl">
        <dt class="text-muted">{tx.phone}</dt>
        <dd class="select-all"><span dir="ltr">{PHONE}</span></dd>
        <dt class="text-muted">{tx.basedIn}</dt>
        <dd>{tx.cityCountry}</dd>
        <dt class="text-muted">LinkedIn</dt>
        <dd>
          <a href="https://www.linkedin.com/in/awab-adam" target="_blank" rel="noopener noreferrer" class="hover:underline">
            in/awab-adam
          </a>
        </dd>
        <dt class="text-muted">{tx.studioSite}</dt>
        <dd>
          <a href="https://awab.design" target="_blank" rel="noopener noreferrer" class="hover:underline">
            awab.design
          </a>
        </dd>
        {
          socialLinks.map((s) => (
            <div class="contents">
              <dt class="text-muted">{s.label}</dt>
              <dd>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:underline" dir="ltr">
                  {s.display}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>

  <SiteFooter />
</Base>
