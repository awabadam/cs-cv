---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "lenis/dist/lenis.css";
import "@/styles/global.css";
import ToTop from "@/components/ToTop.astro";
import { isRtl, languages, localeOf, localized, locales, ui, unlocalized } from "@/i18n/ui";

interface Props {
  /* The page's own title; the site name follows it. Omit on the home page. */
  title?: string;
  description: string;
  /* Open Graph and Twitter text, when it should differ from the page's. */
  share?: { title: string; description: string };
  /* An absolute or site-relative URL; defaults to the site card (public/og.png). */
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, share, image, type = "website", noindex = false } = Astro.props;

/* The language comes from the URL: / is English, /ar and /tr the others. */
const l = localeOf(Astro.url);
const tx = ui[l];
const path = unlocalized(Astro.url);
const site = `${tx.name} — ${tx.role}`;
const fullTitle = title ? `${title} — ${tx.name}` : site;
const og = share ?? { title: title ?? site, description };
const ogImage = new URL(image ?? "/og.png", Astro.site).href;
const href = (to: (typeof locales)[number]) => new URL(localized(path, to), Astro.site).href;

/* Apply a pinned light/dark choice (ThemeSwitch) before first paint, so it never flashes, and
   again on each page the router swaps in, since that brings the new page's bare <html>. */
const themeInit = `(function(){var a=function(){try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}};a();document.addEventListener("astro:after-swap",a)})()`;
---

<!doctype html>
<html lang={l} dir={isRtl(l) ? "rtl" : "ltr"} class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeInit} />
    {/* Links within the site change the page in place, inside a view transition, so a card can
        grow into the cover it opens in any browser with view transitions (src/scripts/motion.ts).
        Browsers without them swap the page straight over. */}
    <ClientRouter fallback="swap" />
    {/* Arabic pages set Arabic in IBM Plex Sans Arabic and keep Zalando Sans for Latin. */}
    {l === "ar" && <Font cssVariable="--font-arabic" preload={[{ weight: "400" }]} />}
    <Font cssVariable="--font-zalando" preload={[{ style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-dm-mono" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={href(l)} />
          {locales.map((to) => (
            <link rel="alternate" hreflang={to} href={href(to)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={href("en")} />
        </>
      )
    }
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={languages[l].og} />
    {locales.filter((to) => to !== l).map((to) => <meta property="og:locale:alternate" content={languages[to].og} />)}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og.title} />
    <meta name="twitter:description" content={og.description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
  </head>
  <body>
    <slot />
    <ToTop />
  </body>
</html>

<script>
  /* Smooth wheel scrolling, and in-page links that glide to their section (respecting
     scroll-margin). Touch keeps the native scroll, and so does anyone who asks the system
     for reduced motion. The image viewer is left to scroll and swipe on its own. */
  import Lenis from "lenis";
  import "@/scripts/motion";
  import { eachPage } from "@/scripts/page";

  /* Exponential ease-out, the same curve as --ease in global.css. */
  const ease = (t: number) => 1 - 2 ** (-10 * t);

  const lenis = new Lenis({
    autoRaf: true,
    /* The wheel catches up with a little under a tenth of the distance left each frame:
       quick to answer, slow to come to rest. */
    lerp: 0.08,
    stopInertiaOnNavigate: true,
    prevent: (node) => !!node.closest("dialog"),
  });
  /* A page swapped in brings its own height. */
  document.addEventListener("astro:after-swap", () => lenis.resize());

  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  /* A section link glides to its section, taking the same time however far away it is. The
     router would jump there first and leave nothing to glide, so this takes the click before
     the router does, and keeps the address in step. #top, as in HTML, is the top of the page,
     and leaves no mark in the address. */
  document.addEventListener(
    "click",
    (e) => {
      const a = e.target instanceof Element ? e.target.closest("a") : null;
      if (!a?.hash || a.href.split("#")[0] !== location.href.split("#")[0]) return;
      if (e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const top = a.hash.toLowerCase() === "#top";
      const section = top ? 0 : document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (section === null) return;
      e.preventDefault();
      lenis.scrollTo(section, calm.matches ? { immediate: true } : { duration: 1.4, easing: ease });
      history.replaceState(history.state, "", top ? location.pathname + location.search : a.hash);
    },
    { capture: true }
  );

  /* Pictures still on their way when the page opens fade in as each arrives, rather than
     snapping in. Ones already there (from the cache) are left alone, and so are the card and
     cover moving between pages (motion.ts), which have to be seen while they move. */
  eachPage(() => {
    for (const img of document.querySelectorAll<HTMLImageElement>("main img")) {
      if (img.complete || img.closest("[data-vt]")) continue;
      img.classList.add("arriving");
      const arrived = () => img.classList.add("arrived");
      img.addEventListener("load", arrived, { once: true });
      img.addEventListener("error", arrived, { once: true });
    }
  });
</script>
